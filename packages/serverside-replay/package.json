{
  "name": "@rrweb/serverside-replay",
  "version": "2.0.0-alpha.20",
  "description": "Generate DOM trees from rrweb recordings at specified timestamps, without a browser",
  "keywords": [
    "rrweb",
    "serverside-replay",
    "dom-snapshot"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/serverside-replay.cjs",
  "module": "./dist/serverside-replay.js",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/serverside-replay.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/serverside-replay.cjs"
      }
    }
  },
  "bin": {
    "serverside-replay": "./dist/cli.js"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "yarn turbo run prepublish",
    "check-types": "tsc -noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "prepublish": "tsc -noEmit && vite build",
    "lint": "yarn eslint src/**/*.ts"
  },
  "dependencies": {
    "rrdom": "^2.0.0-alpha.20",
    "rrdom-nodejs": "^2.0.0-alpha.20",
    "@rrweb/types": "^2.0.0-alpha.20",
    "minimist": "^1.2.5"
  },
  "devDependencies": {
    "@types/minimist": "^1.2.1",
    "@typescript-eslint/eslint-plugin": "^5.23.0",
    "@typescript-eslint/parser": "^5.23.0",
    "eslint": "^8.15.0",
    "typescript": "^5.4.5",
    "vite": "^6.0.1",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^1.4.0"
  }
}
